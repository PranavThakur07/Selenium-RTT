# ==============================================================================
# RoadTripTribes Automation Framework Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your test credentials and environment settings.
# NEVER commit the real '.env' file containing actual passwords to version control.
# ==============================================================================

# Target Application URLs
BASE_URL=https://staging.roadtriptribes.com
LOGIN_URL=https://staging.roadtriptribes.com/login

# Test User Authentication Credentials (Required)
RTT_TEST_EMAIL=your_email@example.com
RTT_TEST_PASSWORD=your_password_here

# Controlled Geolocation Configuration (Optional / Deterministic Testing)
# Sets browser location via Chrome DevTools Protocol (CDP) Emulation.setGeolocationOverride
RTT_GEO_LATITUDE=28.6139
RTT_GEO_LONGITUDE=77.2090
RTT_GEO_ACCURACY=10

# Browser & Driver Execution Settings
BROWSER=chrome
HEADLESS=false
IMPLICIT_TIMEOUT=10
EXPLICIT_TIMEOUT=20
